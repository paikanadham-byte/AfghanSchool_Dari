# ───────────────────────────────────────────────────────────── server ────
PORT=4000
HOST=0.0.0.0
LOG_FORMAT=tiny

# Where the SQLite database and uploaded files live
DATA_DIR=./data
DB_PATH=./data/app.db
MAX_UPLOAD_MB=20

# Set to 1 when the app is served over HTTPS (recommended in production)
COOKIE_SECURE=0

# How often the reminder engine runs (homework, appointments, stock, vaccines)
REMINDER_INTERVAL_MIN=30

# ──────────────────────────────────────────────────────────────── AI ────
# Leave OPENAI_API_KEY empty to use the built-in offline tutor (no internet needed).
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=25000
AI_ENABLED=1
